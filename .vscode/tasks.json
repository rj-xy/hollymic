{
  "version": "2.0.0",
  "tasks": [
    { "label": "cargo build", "type": "shell", "command": "cargo build", "group": { "kind": "build", "isDefault": true }, "problemMatcher": ["$rustc"] },
    { "label": "cargo test", "type": "shell", "command": "cargo test", "group": { "kind": "test", "isDefault": true }, "problemMatcher": ["$rustc"] },
    { "label": "cargo clippy", "type": "shell", "command": "cargo clippy --all-targets", "problemMatcher": ["$rustc"] },
    { "label": "check macOS build", "type": "shell", "command": "cargo check --target aarch64-apple-darwin", "problemMatcher": ["$rustc"] },
    { "label": "run demo", "type": "shell", "command": "cargo run -- --demo --show", "problemMatcher": [] },
    { "label": "status (real receiver)", "type": "shell", "command": "cargo run -- status", "problemMatcher": [] },
    { "label": "screenshots", "type": "shell", "command": "scripts/screenshots.sh", "problemMatcher": [] },
    { "label": "package", "type": "shell", "command": "scripts/package.sh", "problemMatcher": [] }
  ]
}
